# Verilog 电路图生成器后端代理地址。
# 本地开发可使用 docker compose 启动后端后填：http://localhost:8080
# Vercel 生产环境建议配置同名环境变量，前端会通过站内 /api/verilog-schematic/* 代理调用。
VERILOG_API_URL=http://localhost:8080

# Supabase public project settings. These two values may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix this value with NEXT_PUBLIC_ or commit the real key.
SUPABASE_SERVICE_ROLE_KEY=
