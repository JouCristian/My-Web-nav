VOICE_SERVICE_HOST=127.0.0.1
VOICE_SERVICE_PORT=8866

# Allowed web origins that can access the local voice engine.
# CORS uses Origin only (scheme + host + port), not the full page path.
# For https://www.zoujunyispace.cn/joujou-tools/ai-voice-workshop,
# the origin is https://www.zoujunyispace.cn
# Multiple origins are comma-separated. These are MERGED with the built-in defaults:
#   http://localhost:3000, http://127.0.0.1:3000,
#   http://localhost:3001, http://127.0.0.1:3001,
#   https://www.zoujunyispace.cn
VOICE_ALLOWED_ORIGINS=https://www.zoujunyispace.cn

# Optional regex for advanced usage. Keep empty by default.
# Do NOT enable a broad regex that would allow arbitrary public sites
# to call your local engine.
VOICE_ALLOWED_ORIGIN_REGEX=
